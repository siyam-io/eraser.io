# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Public URL of the deployed app, e.g. https://app.example.com
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe billing (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` (or the dashboard webhook)
STRIPE_WEBHOOK_SECRET=
# Price ids for the Pro plan (create them in the Stripe dashboard)
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
